<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:orientation="horizontal">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:orientation="vertical"
        android:gravity="center"
        android:background="@drawable/background_bordo_alpha_radius">

        <ImageView
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_file_check"
            android:tint="@color/black"/>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <TextView
        style="@style/Primary.Text.Style"
        android:id="@+id/textview_name"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="6dp"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:layout_weight="1"
        android:textSize="14sp"
        tools:text="PS169001"
        app:layout_constraintStart_toEndOf="@id/textview_number"
        app:layout_constraintTop_toTopOf="@id/textview_number"
        app:layout_constraintBottom_toBottomOf="@id/textview_number"/>

    <TextView
        android:id="@+id/textview_date"
        style="@style/Primary.Text.Style"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textColor="@color/black"
        android:gravity="center_vertical"
        android:textSize="14sp"
        tools:text="10/10/2023"
        app:layout_constraintTop_toTopOf="@id/textview_number"
        app:layout_constraintEnd_toEndOf="parent"/>



</androidx.appcompat.widget.LinearLayoutCompat>

