<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/Cinza_10" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="24dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Primary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TUSS 22"
                android:textColor="@color/black_2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textview_code_tuss_factor_detail"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:textSize="11sp"
                tools:text="10106014" />

            <TextView
                android:id="@+id/textview_group_factor_detail"
                style="@style/Primary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Grupo de Coparticipação"
                android:textColor="@color/black_2"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/textview_description_group_factor_detail"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:textSize="11sp"
                tools:text="Exame e Procedimento Tipo 6" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="top"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textview_fe_value"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:drawablePadding="8dp"
                android:gravity="end"
                android:paddingStart="12dp"
                android:textColor="@color/Verde"
                android:textSize="12sp"
                tools:text="R$ 235,99" />

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>
</androidx.appcompat.widget.LinearLayoutCompat>
