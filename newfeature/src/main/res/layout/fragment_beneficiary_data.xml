<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".features.guidAuthorizer.ui.fragments.BeneficiaryDataFragment">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/nestedScroolView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="28dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="28dp"
                android:orientation="horizontal">

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Primary.Text.Style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black_2"
                        android:textSize="12sp"
                        android:text="Matícula" />

                    <TextView
                        style="@style/Primary.Text.Style.Bold"
                        android:id="@+id/textview_matricula"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/Bordo"
                        android:textSize="13sp"
                        tools:text="10106014" />

                </androidx.appcompat.widget.LinearLayoutCompat>

                <androidx.appcompat.widget.LinearLayoutCompat
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Primary.Text.Style"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black_2"
                        android:textSize="12sp"
                        android:text="Ordem" />

                    <TextView
                        style="@style/Primary.Text.Style.Bold"
                        android:id="@+id/textview_order"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/Bordo"
                        android:textSize="13sp"
                        tools:text="0" />

                </androidx.appcompat.widget.LinearLayoutCompat>

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="28dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black_2"
                    android:textSize="12sp"
                    android:text="Beneficiário" />

                <TextView
                    style="@style/Primary.Text.Style.Bold"
                    android:id="@+id/textview_name"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/Bordo"
                    android:textSize="13sp"
                    tools:text="ADRIANE SANTANA FERNANDES" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="28dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black_2"
                    android:textSize="12sp"
                    android:text="Telefone *" />

                <EditText
                    style="@style/Primary.Text.Style.Bold"
                    android:id="@+id/editTextPhoneNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:hint="Insira seu telefone"
                    android:inputType="phone"
                    android:textSize="13sp"
                    android:textColor="@color/Bordo" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="28dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black_2"
                    android:textSize="12sp"
                    android:text="Email *" />

                <EditText
                    style="@style/Primary.Text.Style.Bold"
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:hint="@string/text_input_email"
                    android:inputType="textEmailAddress"
                    android:textSize="13sp"
                    android:textColor="@color/Bordo" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:layout_marginHorizontal="28dp"
                android:orientation="vertical">

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black_2"
                    android:textSize="12sp"
                    android:text="Semana Gestacional" />

                <EditText
                    style="@style/Primary.Text.Style.Bold"
                    android:id="@+id/editTextSemGest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:hint="0"
                    android:inputType="numberDecimal"
                    android:digits="0123456789"
                    android:textSize="13sp"
                    android:textColor="@color/Bordo" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

        <Button
            style="@style/Primary.Button.Style"
            android:id="@+id/button_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginVertical="36dp"
            android:layout_marginHorizontal="28dp"
            android:enabled="false"
            android:background="@drawable/button_secondary"
            android:text="@string/confirm"
            android:textAllCaps="false"
            android:textColor="@color/lightText" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <ProgressBar
    android:id="@+id/progress_bar_tickets"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:visibility="gone" />

</FrameLayout>