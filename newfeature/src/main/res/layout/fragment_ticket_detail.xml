<?xml version="1.0" encoding="utf-8"?>

<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        tools:theme="@style/AppTheme">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearLayout_infos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="24dp"
            android:background="@drawable/ticket_detail_background_values"
            android:orientation="vertical">

            <TextView
                style="@style/Primary.Text.Style.Bold"
                android:id="@+id/textview_value_ticket_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="32sp"
                android:textColor="@color/Verde"
                android:gravity="center"
                tools:text="R$ 241,61" />

            <TextView
                style="@style/Primary.Text.Style"
                android:id="@+id/textview_due_ticket_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="16sp"
                android:textColor="@color/Verde"
                android:gravity="center"
                tools:text="vencimento 10/05/2022" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linearLayout_items"
            android:layout_width="match_parent"
            android:layout_marginTop="31dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/linearLayout_description_code_bar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginRight="16dp"
                    android:src="@drawable/ic_ticket" />

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    android:text="@string/ticket_detail_code_payment" />

            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="39dp"
                android:layout_marginHorizontal="24dp"
                android:paddingVertical="36dp"
                android:background="@drawable/ticket_detail_background_codes"
                android:orientation="vertical">

                <TextView
                    style="@style/Primary.Text.Style.Bold"
                    android:id="@+id/textview_code_ticket_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:textSize="16sp"
                    android:textColor="@color/black"
                    android:gravity="center"
                    tools:text="03399492813G982208005033261010238000000000000" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <Button
                android:id="@+id/button_copy_code_ticket_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:layout_marginHorizontal="30dp"
                android:background="@drawable/button_primary_border"
                android:text="@string/ticket_detail_button_copy_code"
                android:textAllCaps="false"
                android:textColor="@color/Bordo" />

            <Button
                android:id="@+id/button_copy_code_ticket_detail_success"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="46dp"
                android:visibility="gone"
                android:layout_marginHorizontal="30dp"
                android:background="@drawable/button_green"
                android:textAllCaps="false"
                android:textColor="@color/Branco" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:gravity="bottom"
                android:layout_weight="1">

                <Button
                    style="@style/Primary.Button.Style"
                    android:id="@+id/button_see_pdf_ticket_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="36dp"
                    android:layout_marginHorizontal="30dp"
                    android:background="@drawable/button_secondary"
                    android:text="@string/ticket_detail_see_document"
                    android:textAllCaps="false"
                    android:textColor="@color/lightText" />

            </androidx.appcompat.widget.LinearLayoutCompat>

        </androidx.appcompat.widget.LinearLayoutCompat>

    </androidx.appcompat.widget.LinearLayoutCompat>

</androidx.core.widget.NestedScrollView>