<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".features.guidAuthorizer.ui.fragments.AnswerQuestionsFragment">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintAnswer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linear_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="horizontal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                style="@style/Primary.Text.Style"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:textColor="@color/black"
                android:textSize="13sp"
                android:text="Pergunta" />

            <TextView
                android:id="@+id/question_hour"
                style="@style/Primary.Text.Style"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:textSize="13sp"
                tools:text="Data 16/03/2023 Hora: 14:32:41" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView
            android:id="@+id/question"
            style="@style/Primary.Text.Style.Bold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginHorizontal="24dp"
            android:textColor="@color/Bordo"
            android:textSize="13sp"
            tools:text="Data 16/03/2023 Hora: 14:32:41"
            app:layout_constraintTop_toBottomOf="@id/linear_question"
            app:layout_constraintStart_toStartOf="parent"/>


        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/linear_answer_all"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/question"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/linear_answer_write"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:text="Resposta" />

                <EditText
                    style="@style/Primary.Text.Style.Bold"
                    android:id="@+id/edittext_answer_write"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:inputType="textMultiLine"
                    android:gravity="top"
                    android:background="@drawable/border_line"
                    android:imeOptions="actionDone"
                    android:lines="8"
                    android:maxLines="10"
                    android:minLines="6"
                    android:textSize="13sp"
                    android:textColor="@color/Bordo" />

            </androidx.appcompat.widget.LinearLayoutCompat>


            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/linear_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    style="@style/Primary.Text.Style"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:layout_weight="1"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    android:text="Resposta" />

                <TextView
                    android:id="@+id/answer_hour"
                    style="@style/Primary.Text.Style"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/black"
                    android:textSize="13sp"
                    tools:text="Data 16/03/2023 Hora: 14:32:41" />

            </androidx.appcompat.widget.LinearLayoutCompat>

            <TextView
                android:id="@+id/answer"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/Bordo"
                android:textSize="13sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/linear_answer"
                tools:text="Data 16/03/2023 Hora: 14:32:41" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <TextView
            style="@style/Primary.Text.Style.Bold"
            android:id="@+id/attachment"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginHorizontal="24dp"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:text="Anexos"
            app:layout_constraintTop_toBottomOf="@id/linear_answer_all"
            app:layout_constraintStart_toStartOf="parent"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_income_tax"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            app:spanCount="10"
            tools:listitem="@layout/adapter_picture"
            app:layout_constraintTop_toBottomOf="@id/attachment"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <ImageView
            android:id="@+id/button_picture"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginBottom="24dp"
            android:layout_marginEnd="24dp"
            android:src="@drawable/ic_add_a_photo"
            android:padding="16dp"
            android:layout_gravity="bottom"
            android:background="@drawable/background_bordo_rounded"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toTopOf="@id/button_process_request"/>

        <Button
            style="@style/Primary.Button.Style"
            android:id="@+id/button_process_request"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:background="@drawable/button_secondary_old"
            android:text="Enviar Resposta"
            android:textAllCaps="false"
            android:enabled="false"
            android:textColor="@color/lightText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <ProgressBar
        android:id="@+id/progress_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</FrameLayout>