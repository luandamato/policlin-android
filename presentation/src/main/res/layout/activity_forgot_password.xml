<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/darkBg">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageViewLogo"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_gravity="center"
                android:layout_marginBottom="20dp"
                android:layout_marginTop="60dp"
                app:srcCompat="@drawable/logo_policlin_white" />


            <TextView
                android:id="@+id/textViewMsgRecoverPassword"
                style="@style/Primary.Text.Ligt.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:layout_marginEnd="@dimen/margin_login_default"
                android:layout_marginLeft="@dimen/margin_login_default"
                android:layout_marginRight="@dimen/margin_login_default"
                android:layout_marginStart="@dimen/margin_login_default"
                android:layout_marginTop="20dp"
                android:gravity="center"
                android:text="@string/msg_instruction_recover_password"
                android:textAllCaps="true"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_vertical_spacing_default"
                android:layout_marginEnd="@dimen/margin_extra_large"
                android:layout_marginLeft="@dimen/margin_extra_large"
                android:layout_marginRight="@dimen/margin_extra_large"
                android:layout_marginStart="@dimen/margin_extra_large">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutRegister"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:theme="@style/Primary.TextInputLayout.Light.Style">

                    <EditText
                        android:id="@+id/editTextRegister"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:drawablePadding="8dp"
                        android:drawableStart="@drawable/ic_matricula_white"
                        android:hint="@string/text_register"
                        android:inputType="number"
                        android:nextFocusDown="@+id/editTextOrder"
                        android:nextFocusForward="@+id/editTextOrder"
                        android:nextFocusRight="@+id/editTextOrder"
                        android:textColor="@color/lightText" />

                </com.google.android.material.textfield.TextInputLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:paddingEnd="8dp"
                    android:paddingStart="8dp"
                    android:text="-"
                    android:textColor="@color/white"
                    android:textSize="20sp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/inputLayoutOrder"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="72dp"
                    android:theme="@style/Primary.TextInputLayout.Light.Style">

                    <EditText
                        android:id="@+id/editTextOrder"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/text_order"
                        android:inputType="number"
                        android:nextFocusDown="@+id/editTextEmail"
                        android:nextFocusForward="@+id/editTextEmail"
                        android:nextFocusRight="@+id/editTextEmail"
                        android:textColor="@color/lightText" />

                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/inputLayoutEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                android:layout_marginLeft="@dimen/margin_extra_large"
                android:layout_marginRight="@dimen/margin_extra_large"
                android:theme="@style/Primary.TextInputLayout.Light.Style">

                <EditText
                    android:id="@+id/editTextEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:drawablePadding="8dp"
                    android:drawableStart="@drawable/ic_email"
                    android:hint="@string/text_input_email"
                    android:inputType="textEmailAddress"
                    android:nextFocusDown="@+id/buttonRecoverPassword"
                    android:nextFocusForward="@+id/buttonRecoverPassword"
                    android:nextFocusRight="@+id/buttonRecoverPassword"
                    android:textColor="@color/lightText" />

            </com.google.android.material.textfield.TextInputLayout>


            <Button
                android:id="@+id/buttonRecoverPassword"
                style="@style/Primary.Button.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_vertical_spacing_default"
                android:layout_marginLeft="@dimen/margin_extra_large"
                android:layout_marginRight="@dimen/margin_extra_large"
                android:layout_marginTop="20dp"
                android:text="@string/action_recover_password"
                app:layout_constraintTop_toBottomOf="@+id/login_progressbar" />


            <Button
                android:id="@+id/buttonBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/margin_extra_large"
                android:layout_marginRight="@dimen/margin_extra_large"
                android:layout_marginTop="8dp"
                android:background="@drawable/button_selector_border_secondary"
                android:text="@string/action_back"
                android:textColor="@android:color/white"
                app:layout_constraintTop_toBottomOf="@+id/buttonRecoverPassword" />

        </LinearLayout>

    </ScrollView>

    <include
        android:id="@+id/loadingView"
        layout="@layout/view_loading" />
</FrameLayout>