<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white_2"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="88dp"
                android:layout_marginBottom="20dp"
                android:scaleType="fitXY"
                app:srcCompat="@drawable/login_header_new" />

            <android.support.v7.widget.CardView
                android:id="@+id/cardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_vertical_spacing_default"
                android:layout_marginLeft="40dp"
                android:layout_marginRight="40dp"
                app:layout_constraintBottom_toTopOf="@+id/buttonIamNotClient"
                card_view:cardCornerRadius="5dp"
                card_view:cardElevation="4dp"
                card_view:layout_editor_absoluteX="38dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:animateLayoutChanges="true"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/title_client_area"
                        android:textAlignment="center" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/inputLayoutRegister"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:layout_weight="1">

                            <android.support.design.widget.TextInputEditText
                                android:id="@+id/editTextRegister"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:drawableStart="@drawable/ic_matricula"
                                android:hint="@string/text_register"
                                android:inputType="number"
                                android:lines="1"
                                android:maxLength="10"
                                android:nextFocusDown="@+id/editTextOrder"
                                android:nextFocusForward="@+id/editTextOrder"
                                android:nextFocusRight="@+id/editTextOrder" />

                        </android.support.design.widget.TextInputLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="16dp"
                            android:minWidth="20dp"
                            android:paddingEnd="4dp"
                            android:paddingStart="4dp"
                            android:text="-"
                            android:textSize="20sp" />

                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/intpuLayoutOrder"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp">

                            <android.support.design.widget.TextInputEditText
                                android:id="@+id/editTextOrder"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="@string/text_order"
                                android:inputType="number"
                                android:lines="1"
                                android:maxLength="2"
                                android:minWidth="64dp"
                                android:nextFocusForward="@+id/editTextPassword"
                                android:nextFocusRight="@+id/editTextPassword" />

                        </android.support.design.widget.TextInputLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="270dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">


                        <android.support.design.widget.TextInputLayout
                            android:id="@+id/inputLayoutPassword"
                            android:layout_width="185dp"
                            android:layout_height="wrap_content">

                            <android.support.design.widget.TextInputEditText
                                android:id="@+id/editTextPassword"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:drawablePadding="8dp"
                                android:drawableStart="@drawable/ic_senha"
                                android:hint="@string/text_password"
                                android:inputType="textPassword"
                                android:nextFocusForward="@+id/buttonForgotPassword"
                                android:nextFocusRight="@+id/buttonForgotPassword" />

                        </android.support.design.widget.TextInputLayout>

                        <ImageView
                            android:id="@+id/imgEye"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical|center_horizontal"
                            android:src="@drawable/ic_action_eye_closed" />


                    </LinearLayout>

                    <Button
                        android:id="@+id/buttonForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="right"
                        android:layout_marginTop="12dp"
                        android:background="@android:color/transparent"
                        android:text="@string/action_forgot_password"
                        android:textColor="#A6A6A6"
                        android:textSize="12sp" />

                    <Button
                        android:id="@+id/buttonNotHasPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="20dp"
                        android:layout_gravity="right"
                        android:layout_marginBottom="30dp"
                        android:background="@android:color/transparent"
                        android:text="@string/action_not_has_password"
                        android:textColor="#A6A6A6"
                        android:textSize="12sp" />

                    <ProgressBar
                        android:id="@+id/login_progressbar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:visibility="gone" />

                    <Button
                        android:id="@+id/buttonEnter"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/button_selector_secondary"
                        android:text="@string/global_enter"
                        android:textColor="@android:color/white" />

                </LinearLayout>

            </android.support.v7.widget.CardView>

            <Button
                android:id="@+id/buttonIamNotClient"
                style="@style/Primary.Button.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginLeft="@dimen/margin_login_default"
                android:layout_marginRight="@dimen/margin_login_default"
                android:layout_marginTop="20dp"
                android:text="@string/action_i_am_not_client"
                app:layout_constraintBottom_toTopOf="@+id/textViewMsgWhenEntering" />

            <TextView
                android:id="@+id/textViewMsgWhenEntering"
                style="@style/Secondary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_vertical_spacing_default"
                android:layout_marginLeft="@dimen/margin_login_default"
                android:layout_marginRight="@dimen/margin_login_default"
                android:gravity="center"
                android:text="@string/msg_when_entering_you_allow" />

            <ImageView
                android:id="@+id/imageView2"
                android:layout_width="120dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:layout_marginBottom="16dp"
                android:layout_marginEnd="8dp"
                android:layout_marginStart="8dp"
                android:layout_marginTop="40dp"
                app:srcCompat="@drawable/tarja" />

        </LinearLayout>
    </ScrollView>


    <FrameLayout
        android:id="@+id/loading_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/loadingBackground">

        <ProgressBar
            android:id="@+id/progressbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </FrameLayout>

</FrameLayout>