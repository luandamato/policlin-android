<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="8dp">


    <TextView
        android:id="@+id/textViewTitle"
        style="@style/Primary.Text.Style"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="Razao social" />

    <LinearLayout
        android:id="@+id/linearLayout_telefone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewInfo"
            style="@style/Secondary.Text.Style"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAllCaps="true"
            android:textSize="14sp"
            tools:text="Razao social" />

        <ImageView
            android:id="@+id/iconWhatsAppPhoneOne"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:visibility="gone"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            app:srcCompat="@drawable/ic_whatsapp"
            tools:visibility="visible"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/linearLayout_telefone2"
        android:visibility="gone"
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textViewInfo2"
            style="@style/Secondary.Text.Style"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:layout_gravity="bottom"
            android:textAllCaps="true"
            android:textSize="14sp"
            tools:text="Razao social" />

        <ImageView
            android:id="@+id/iconWhatsAppPhoneTwo"
            android:layout_width="17dp"
            android:layout_height="17dp"
            android:visibility="gone"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="4dp"
            app:srcCompat="@drawable/ic_whatsapp"
            tools:visibility="visible"/>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/qualificationsRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>