<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.Light.NoActionBar">
        <!-- Customize your theme here. -->
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorPrimary</item>
<!--        <item name="ms_stepperStyle">@style/CustomStepperLayoutTheme</item>-->
    </style>

    <style name="AppTheme.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="AppTheme.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />


    <style name="Primary.Button.Style" parent="Base.Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_selector_primary</item>
        <item name="android:textAlignment">center</item>
        <item name="android:minHeight">@dimen/primary_button_height</item>
        <item name="android:textAppearance">@style/Primary.Button.Text.Style</item>
    </style>

    <style name="Primary.Button.Text.Style" parent="Base.TextAppearance.AppCompat.Button">
        <item name="android:textColor">@color/primaryButtonText</item>
    </style>

    <style name="Primary.Text.Style" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/primaryButtonText</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Primary.Text.Style.Bold">
        <item name="android:textStyle">bold</item>
    </style>


    <style name="Secondary.Text.Style" parent="@android:style/TextAppearance">
        <item name="android:textColor">@color/secondaryText</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Secondary.Text.Style.Bold">
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Primary.Text.Ligt.Style" parent="Primary.Text.Style">
        <item name="android:textColor">@color/lightText</item>
    </style>

    <!-- TODO: Stepper styles removed - library deprecated -->

    <style name="Primary.TextInputLayout.Light.Style" parent="Widget.Design.TextInputLayout">
        <item name="android:textColorHint">@color/lightText</item>
        <item name="colorControlNormal">@color/lightText</item>
        <item name="colorControlActivated">@color/lightText</item>
        <item name="colorControlHighlight">@color/lightText</item>
    </style>
</resources>
