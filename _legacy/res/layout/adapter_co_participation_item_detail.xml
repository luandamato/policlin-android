<?xml version="1.0" encoding="utf-8"?>
<androidx.appcompat.widget.LinearLayoutCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginBottom="10dp"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp"
        android:orientation="horizontal">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/Primary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/black_2"
                android:textSize="10sp"
                android:text="Data Atendimento" />

            <TextView
                android:id="@+id/textview_date"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:gravity="start"
                android:textSize="11sp"
                tools:text="01/01/2020" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:orientation="vertical">

            <TextView
                style="@style/Primary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/black_2"
                android:gravity="end"
                android:textSize="10sp"
                android:text="Prestador" />

            <TextView
                android:id="@+id/textview_name_locale"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="end"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:textSize="11sp"
                tools:text="Policlin" />

        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:background="@color/Cinza_10" />

    <androidx.appcompat.widget.LinearLayoutCompat
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:paddingVertical="14dp">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Primary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/black_2"
                android:textSize="11sp"
                android:text="Código TUSS 22" />

            <TextView
                android:id="@+id/textview_code_tuss_factor_detail"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:textSize="11sp"
                tools:text="10106014" />

            <TextView
                style="@style/Primary.Text.Style"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/black_2"
                android:textSize="11sp"
                android:text="Procedimento TUSS 22" />

            <TextView
                android:id="@+id/textview_procedure_tuss_factor_detail"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:textSize="11sp"
                tools:text="Aconselhamento genético" />

            <TextView
                style="@style/Primary.Text.Style"
                android:id="@+id/textview_group_factor_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/black_2"
                android:textSize="11sp"
                android:text="Descrição do Grupo" />

            <TextView
                android:id="@+id/textview_description_group_factor_detail"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/Bordo"
                android:textSize="11sp"
                tools:text="Exame e Procedimento Tipo 6" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="top">

            <TextView
                android:id="@+id/textview_fe_value"
                style="@style/Primary.Text.Style.Bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:layout_gravity="end"
                android:layout_weight=".5"
                android:gravity="end"
                android:textColor="@color/Verde"
                android:drawablePadding="8dp"
                android:textSize="12sp"
                tools:text="R$ 235,99" />

        </androidx.appcompat.widget.LinearLayoutCompat>


    </androidx.appcompat.widget.LinearLayoutCompat >

    <View
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_marginTop="14dp"
        android:background="@color/Cinza_10" />

</androidx.appcompat.widget.LinearLayoutCompat >